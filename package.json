{
  "name": "agentcore-os",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "dev": "next dev",
    "dev:clean": "node -e \"require('fs').rmSync('.next-dev',{recursive:true,force:true});\" && next dev -p 3000",
    "build": "next build",
    "build:desktop-web": "node scripts/desktop-runtime/build-static.mjs",
    "desktop:build-doctor": "node scripts/desktop-runtime/build-doctor.mjs",
    "desktop:build-claw-runtime": "node scripts/desktop-runtime/build-claw-runtime.mjs",
    "desktop:build-sidecar": "npm run desktop:build-claw-runtime",
    "desktop:package": "node scripts/desktop-runtime/package-desktop.mjs",
    "desktop:prepare-claw-runtime": "node scripts/desktop-runtime/prepare-claw-runtime.mjs",
    "desktop:prepare-sidecar": "node scripts/desktop-runtime/prepare-claw-runtime.mjs",
    "desktop:stage-claw-runtime": "node scripts/desktop-runtime/stage-claw-runtime.mjs",
    "desktop:stage-sidecar": "node scripts/desktop-runtime/stage-claw-runtime.mjs",
    "desktop:smoke-test-sidecar": "node scripts/desktop-runtime/smoke-test-sidecar.mjs",
    "tauri": "node scripts/desktop-runtime/run-tauri.mjs",
    "tauri:dev": "node scripts/desktop-runtime/run-tauri.mjs dev",
    "tauri:build": "node scripts/desktop-runtime/run-tauri.mjs build",
    "start": "next start",
    "stable": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true});\" && next build && next start -p 3000",
    "test:core-workflows": "node --import ./scripts/register-ts-alias-loader.mjs ./scripts/regression/workflows.mjs",
    "test:controlled-runtime": "vitest run src/__tests__/lib/executor/playbooks/sales-pipeline.test.ts src/__tests__/lib/executor/playbooks/validator.test.ts src/__tests__/lib/executor/runtime/schema.test.ts src/__tests__/lib/executor/runtime/step-input.test.ts src/__tests__/lib/executor/runtime/console-summary.test.ts src/__tests__/lib/executor/runtime/resume.test.ts src/__tests__/lib/server/controlled-execution-store.test.ts src/__tests__/lib/executor/approval-store.test.ts src/__tests__/lib/executor/controlled-runtime.test.ts src/__tests__/lib/executor/step-executor.test.ts src/__tests__/lib/executor/run-workflow-multi-step.test.ts src/__tests__/app/api/agent-stream-route.test.ts src/__tests__/app/api/controlled-run-route.test.ts src/__tests__/app/api/controlled-run-resume-route.test.ts src/__tests__/app/api/controlled-run-retry-route.test.ts src/__tests__/hooks/useMultiStepStream.test.tsx src/__tests__/components/ClawRuntimeConsoleAppWindow.test.tsx src/__tests__/lib/asset-record-focus.test.ts src/__tests__/components/DealDeskAppWindow.test.tsx src/__tests__/components/KnowledgeVaultAppWindow.test.tsx",
    "test:publish": "node --import ./scripts/register-ts-alias-loader.mjs ./scripts/regression/publish.mjs",
    "test:stability": "npm run test:core-workflows && npm run test:publish && npm run lint && npm run build",
    "lint": "next lint",
    "webhook:dev": "node scripts/webhook-connector/server.mjs",
    "publish-queue:worker": "node scripts/publish-queue-worker.mjs",
    "runtime:doctor": "node scripts/desktop-runtime/doctor.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "5.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.27",
    "eslint": "^9",
    "eslint-config-next": "15.1.6",
    "jsdom": "^25.0.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
